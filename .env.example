# Backup Buddies control-plane API. Leave this as-is unless you're running
# against a self-hosted instance of the service.
API_URL=https://api.filegarden.net

# From your dashboard's Devices card → "Add device". Shown once at
# creation time — if you lose it, remove the device and create a new one.
DEVICE_TOKEN=paste_your_device_token_here

# A passphrase ONLY you know. It encrypts your data before it ever leaves
# this machine — your buddy's computer only ever stores the encrypted
# result and cannot read it, and Backup Buddies' own servers never see
# this value at all. There is no "forgot passphrase" recovery: if you lose
# it, whatever's stored with your buddy is unrecoverable. Use a real
# passphrase (a few random words), not a short password.
BACKUP_PASSPHRASE=change_me_to_something_only_you_know

# Leave as-is unless you're told otherwise.
RELAY_URL=https://relay.filegarden.net

# ---------------------------------------------------------------------
# FOLDERS
#
# The client uses four separate folders, so its own files never get mixed
# into your data. Use absolute paths, or relative ones starting with ./
# (relative to this file). Any that don't exist are created.
#
#   BACKUP_DIR_HOST       Your files — what gets backed up. Mounted
#                         read-only: the client never writes here.
#   BUDDY_FILES_DIR_HOST  What your buddies store with you (encrypted).
#                         Needs the space you pledged. Give it a folder of
#                         its own — the client makes one subfolder per buddy
#                         inside it.
#   RESTORE_DIR_HOST      Where files you restore from a buddy are written.
#   DATA_DIR_HOST         Config: identity key + small bookkeeping files.
#                         Keep it here, next to this file.
#
# Example A — one data drive, two folders on it:
#   BACKUP_DIR_HOST=/mnt/storage/my-files
#   BUDDY_FILES_DIR_HOST=/mnt/storage/buddy-files
#   RESTORE_DIR_HOST=/mnt/storage/restored
#
# Example B — two separate mounts (e.g. two disks or NAS shares):
#   BACKUP_DIR_HOST=/mnt/my-data
#   BUDDY_FILES_DIR_HOST=/mnt/buddy-data
#
# Don't put BUDDY_FILES_DIR_HOST or RESTORE_DIR_HOST *inside*
# BACKUP_DIR_HOST — you'd end up backing up your buddy's files (or your own
# restores) back out to your buddy. And don't point two devices' clients at
# the same folders — each needs its own.
# ---------------------------------------------------------------------

# Leave commented out if this device only receives — it'll still store
# whatever your buddy sends, it just won't send anything of its own.
#BACKUP_DIR_HOST=/mnt/storage/my-files

# If your backup folder ever looks completely empty while your buddy holds
# files from it, the client pauses instead of deleting them all from your
# buddy — that's almost always a drive that isn't mounted. If you really
# did delete everything on purpose, set this to true and restart, then
# remove it again once that has synced (left on, it disables the check).
#ALLOW_EMPTY_BACKUP_DIR=true

# Defaults to ./buddy-files next to this file if left unset — fine for a
# quick test, but set it to a folder on the drive that has the space.
BUDDY_FILES_DIR_HOST=./buddy-files

# Defaults to ./restored next to this file.
#RESTORE_DIR_HOST=/mnt/storage/restored

DATA_DIR_HOST=./config

# ---------------------------------------------------------------------
# FILE OWNERSHIP
#
# Runs the client as your own user, so everything it creates — restored
# files especially — belongs to you instead of root (no sudo needed to
# edit, move or delete them). Also needed if BUDDY_FILES_DIR_HOST is on an
# NFS share, where root usually can't write. Find your numbers with
# `id -u` and `id -g` on this machine. Comment both out to run as root.
# ---------------------------------------------------------------------
PUID=1000
PGID=1000

# Port on THIS machine for the local status dashboard — pledge usage,
# last backup cycle, and restore, for this device. The app binds this
# port directly on the host (see docker-compose.yml's network_mode:
# host), so it's reachable from anywhere that can reach this machine on
# this port (your LAN, or the open internet if this machine is exposed to
# it), so it only opens there once DASHBOARD_PASSWORD (below) is set.
# Defaults to 8080; change it if
# that's taken, OR if you're running more than one device's client on
# this same host — each one needs its own DASHBOARD_PORT (and its own
# SYNC_PORT below), since with network_mode: host there's no per-container
# port mapping to keep them from colliding on the same physical port.
# To restrict this to the machine itself instead of the LAN, set
# DASHBOARD_BIND=127.0.0.1:8080 instead (overrides this port setting).
#DASHBOARD_PORT=8080

# Login for that dashboard. Without a password it only opens on this
# machine itself (http://localhost:8080); set one to open it from your
# other devices. User name defaults to admin. To change either, edit here
# and run docker compose up -d.
#DASHBOARD_PASSWORD=
#DASHBOARD_USER=admin

# UDP port this device uses for the actual sync connection to your buddy
# (separate from DASHBOARD_PORT's dashboard, which is plain TCP/HTTP).
# Backup Buddies always works without touching this — if your buddy can't
# be reached directly, traffic just relays instead, same as always. But
# relaying costs more (latency, and relay bandwidth that isn't free past
# the free tier) than a direct connection, and direct only has a chance of
# working at all if *something* outside your network can reach this port.
# If you can forward a UDP port on your router, forward this one to this
# machine. Defaults to 11235; change it if that's taken, if your router
# makes a different port easier to forward, or if you're running more
# than one device's client on this same host (each needs its own, same
# as DASHBOARD_PORT above).
#SYNC_PORT=11235

# How often (in seconds) to check your backup folder for changes and sync
# with your buddy. Defaults to 30. A check only reads files whose size or
# modified time changed, so it's cheap even for big folders; raise it (e.g.
# 900 for 15 minutes) if your folder is huge or on a slow network share.
#SCAN_INTERVAL_SECS=30

# Files that are never backed up are listed in excludes.txt in the config
# folder (DATA_DIR_HOST, ./config by default), which the client creates
# with examples on first start. On top of that, a built-in list of poor
# fits is skipped: Outlook PST/OST, live database files (*.db, *.sqlite,
# ...), virtual machine disks (*.vmdk, *.vhdx, *.qcow2, ...), temp files
# and OS clutter. Set this to off to back those up too, or bring back just
# one type with a `!` line in excludes.txt (e.g. `!(?i)*.pst`).
#DEFAULT_EXCLUDES=on

# How long (in seconds) a buddy can go without a *successful* backup/ping
# cycle before the dashboard calls them out as stale, separately from a
# single failed cycle. Defaults to 600 (10 minutes), or 3× SCAN_INTERVAL_SECS
# if that's longer — long enough that a couple of transient network blips
# don't trip it.
#STALE_AFTER_SECS=600

# ---------------------------------------------------------------------
# UPDATE CHECK (optional)
#
# The local dashboard checks, every few hours, whether a newer client
# version has been released and says so on the "This Device" card. It only
# reads one small public file (the version number) — nothing about you is
# sent beyond the normal request. Leave this unset to use the default;
# set it to "off" to disable the check, or to a URL of a Cargo.toml to
# check against a self-hosted instance instead.
# UPDATE_CHECK_URL=off
